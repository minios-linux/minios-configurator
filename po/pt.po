#: lib/config_state.py:60 lib/config_state.py:61
msgid "Password unchanged"
msgstr "Senha não alterada"

#: lib/config_state.py:61
msgid "Password will be changed"
msgstr "A senha será alterada"

#: lib/config_utils.py:43 lib/config_utils.py:70
msgid "Config file must be a regular file."
msgstr "O arquivo de configuração deve ser um arquivo regular."

#: lib/config_utils.py:57
msgid "Failed to load config: {}"
msgstr "Falha ao carregar a configuração: {}"

#: lib/config_utils.py:139
msgid "Failed to update config: {}"
msgstr "Falha ao atualizar a configuração: {}"

#: lib/main_configurator.py:72
msgid "User"
msgstr "Usuário"

#: lib/main_configurator.py:73
msgid "Username"
msgstr "Nome de usuário"

#: lib/main_configurator.py:74
msgid ""
"Set the default username for the live session.\n"
"\n"
"• This user is created automatically at boot.\n"
"\n"
"See: man 7 live-config (search 'username')"
msgstr ""
"Defina o nome de usuário padrão para a sessão live.\n"
"\n"
"• Este usuário é criado automaticamente na inicialização.\n"
"\n"
"Ver: man 7 live-config (procurar 'username')"

#: lib/main_configurator.py:77
msgid "Full name"
msgstr "Nome completo"

#: lib/main_configurator.py:78
msgid ""
"Enter the full name for the default user.\n"
"\n"
"• Used for display purposes (e.g., on login screens).\n"
"\n"
"See: man 7 live-config (search 'user-fullname')"
msgstr ""
"Digite o nome completo para o usuário padrão.\n"
"\n"
"• Usado para fins de exibição (por exemplo, em telas de login).\n"
"\n"
"Ver: man 7 live-config (procurar 'user-fullname')"

#: lib/main_configurator.py:81
msgid "User groups"
msgstr "Grupos de usuário"

#: lib/main_configurator.py:82
msgid ""
"Specify additional groups for the user, separated by commas or spaces.\n"
"\n"
"• Grants access to devices and features (e.g., 'audio, video, plugdev').\n"
"\n"
"See: man 7 live-config (search 'user-default-groups')"
msgstr ""
"Especifique grupos adicionais para o usuário, separados por vírgulas ou espaços.\n"
"\n"
"• Concede acesso a dispositivos e recursos (por exemplo, 'audio, video, plugdev').\n"
"\n"
"Ver: man 7 live-config (procurar 'user-default-groups')"

#: lib/main_configurator.py:85
msgid "User password"
msgstr "Senha do usuário"

#: lib/main_configurator.py:86
msgid ""
"Set the initial password for the default user.\n"
"\n"
"• Leave blank to keep the existing password.\n"
"• Spaces are not allowed.\n"
"\n"
"See: man 7 live-config (search 'user-password')"
msgstr ""
"Defina a senha inicial para o usuário padrão.\n"
"\n"
"• Deixe em branco para manter a senha existente.\n"
"• Espaços não são permitidos.\n"
"\n"
"Ver: man 7 live-config (procurar 'user-password')"

#: lib/main_configurator.py:90
msgid "Root password"
msgstr "Senha do root"

#: lib/main_configurator.py:91
msgid ""
"Set the initial password for the root (administrator) account.\n"
"\n"
"• Leave blank to keep the existing password.\n"
"• Spaces are not allowed; ignored if 'No-root mode' is enabled.\n"
"\n"
"See: man 7 live-config (search 'root-password')"
msgstr ""
"Defina a senha inicial para a conta root (administrador).\n"
"\n"
"• Deixe em branco para manter a senha existente.\n"
"• Espaços não são permitidos; ignorado se o 'Modo sem root' estiver ativado.\n"
"\n"
"Ver: man 7 live-config (procurar 'root-password')"

#: lib/main_configurator.py:95
msgid "Link user directories to storage"
msgstr "Vincular diretórios de usuário ao armazenamento"

#: lib/main_configurator.py:96
msgid ""
"If enabled, user home directories will be symlinked to persistent storage.\n"
"\n"
"• Uses the FAT32, exFAT, or NTFS MiniOS drive.\n"
"• Unavailable with toram, toram=full, and toram=trim.\n"
"• Conflicting non-empty folders are never merged automatically.\n"
"\n"
"See: man 7 live-config (search 'link-user-dirs')"
msgstr ""
"Se ativado, os diretórios home dos usuários serão vinculados por link simbólico ao armazenamento persistente.\n"
"\n"
"• Utiliza o drive MiniOS em FAT32, exFAT ou NTFS.\n"
"• Indisponível com toram, toram=full e toram=trim.\n"
"• Pastas conflitantes e não vazias nunca são mescladas automaticamente.\n"
"\n"
"Veja: man 7 live-config (procure por 'link-user-dirs')"

#: lib/main_configurator.py:101
msgid "Bind user directories to storage"
msgstr "Montar diretórios de usuário no armazenamento"

#: lib/main_configurator.py:102
msgid ""
"If enabled, user home directories will be bind-mounted to persistent storage.\n"
"\n"
"• Uses the FAT32, exFAT, or NTFS MiniOS drive.\n"
"• Unavailable with toram, toram=full, and toram=trim.\n"
"• Conflicting non-empty folders are never merged automatically.\n"
"\n"
"See: man 7 live-config (search 'bind-user-dirs')"
msgstr ""
"Se ativado, os diretórios home dos usuários serão montados via bind no armazenamento persistente.\n"
"\n"
"• Utiliza o drive MiniOS em FAT32, exFAT ou NTFS.\n"
"• Indisponível com toram, toram=full e toram=trim.\n"
"• Pastas conflitantes e não vazias nunca são mescladas automaticamente.\n"
"\n"
"Veja: man 7 live-config (procure por 'bind-user-dirs')"

#: lib/main_configurator.py:107
msgid "User directories path on storage"
msgstr "Caminho dos diretórios de usuário no armazenamento"

#: lib/main_configurator.py:108
msgid ""
"Set the base path on persistent storage for user directories.\n"
"\n"
"• Example: '/minios/userdirs'.\n"
"\n"
"• The path must stay inside the MiniOS drive; '.', '..', and empty segments are not allowed.\n"
"\n"
"See: man 7 live-config (search 'user-dirs-path')"
msgstr ""
"Defina o caminho base no armazenamento persistente para os diretórios de usuários.\n"
"\n"
"• Exemplo: '/minios/userdirs'.\n"
"\n"
"• O caminho deve permanecer dentro do drive MiniOS; '.', '..' e segmentos vazios não são permitidos.\n"
"\n"
"Veja: man 7 live-config (procure por 'user-dirs-path')"

#: lib/main_configurator.py:113
msgid "System"
msgstr "Sistema"

#: lib/main_configurator.py:114
msgid "No-root mode"
msgstr "Modo sem root"

#: lib/main_configurator.py:115
msgid ""
"If enabled, disables the root account, enhancing security.\n"
"\n"
"• Prevents root login and administrator access.\n"
"• Ideal for live sessions.\n"
"\n"
"See: man 7 live-config (search 'noroot')"
msgstr ""
"Se ativado, desabilita a conta root, aumentando a segurança.\n"
"\n"
"• Impede o login de root e o acesso de administrador.\n"
"• Ideal para sessões live.\n"
"\n"
"Ver: man 7 live-config (procurar 'noroot')"

#: lib/main_configurator.py:119
msgid "Hostname"
msgstr "Nome do host"

#: lib/main_configurator.py:120
msgid ""
"Set the computer's network name (hostname).\n"
"\n"
"• Allowed characters: letters, numbers, hyphens.\n"
"• Example: 'minios-pc'.\n"
"\n"
"See: man 7 live-config (search 'hostname')"
msgstr ""
"Defina o nome de rede do computador (hostname).\n"
"\n"
"• Caracteres permitidos: letras, números, hífens.\n"
"• Exemplo: 'minios-pc'.\n"
"\n"
"Ver: man 7 live-config (procurar 'hostname')"

#: lib/main_configurator.py:124
msgid "Locales"
msgstr "Idiomas"

#: lib/main_configurator.py:125
msgid ""
"Set system language(s) and regional settings.\n"
"\n"
"• Enter locale codes separated by commas (e.g. 'de_DE.UTF-8, en_US.UTF-8').\n"
"• The first locale is treated as default.\n"
"\n"
"See: man 7 live-config (search 'locales')"
msgstr ""
"Defina o(s) idioma(s) do sistema e as configurações regionais.\n"
"\n"
"• Insira os códigos de localidade separados por vírgulas (ex: 'de_DE.UTF-8, en_US.UTF-8').\n"
"• A primeira localidade é tratada como padrão.\n"
"\n"
"Ver: man 7 live-config (procurar 'locales')"

#: lib/main_configurator.py:129
msgid "Timezone"
msgstr "Fuso horário"

#: lib/main_configurator.py:130
msgid ""
"Set the system timezone (e.g., 'Europe/Berlin', 'America/New_York').\n"
"\n"
"• Affects system clock and displayed times.\n"
"\n"
"See: man 7 live-config (search 'timezone')"
msgstr ""
"Defina o fuso horário do sistema (por exemplo, 'Europe/Berlin', 'America/New_York').\n"
"\n"
"• Afeta o relógio do sistema e os horários exibidos.\n"
"\n"
"Ver: man 7 live-config (procurar 'timezone')"

#: lib/main_configurator.py:133
msgid "Default boot target"
msgstr "Destino de boot padrão"

#: lib/main_configurator.py:134
msgid ""
"Set the default boot target:\n"
"• 'graphical.target' – start with a desktop.\n"
"• 'multi-user.target' – console mode.\n"
"• 'rescue.target' – minimal rescue mode.\n"
"\n"
"Short aliases like 'graphical' and 'multi-user' are accepted."
msgstr ""
"Defina o destino de boot padrão:\n"
"• 'graphical.target' – inicia com interface gráfica.\n"
"• 'multi-user.target' – modo console.\n"
"• 'rescue.target' – modo de resgate mínimo.\n"
"\n"
"Apelidos curtos como 'graphical' e 'multi-user' são aceitos."

#: lib/main_configurator.py:139
msgid "Enable services"
msgstr "Ativar serviços"

#: lib/main_configurator.py:140
msgid ""
"List services to enable at boot, separated by commas.\n"
"\n"
"• Example: 'ssh, NetworkManager'.\n"
"• systemd units and sysvinit script names are supported."
msgstr ""
"Liste os serviços para habilitar na inicialização, separados por vírgulas.\n"
"\n"
"• Exemplo: 'ssh, NetworkManager'.\n"
"• Nomes de unidades systemd e scripts sysvinit são suportados."

#: lib/main_configurator.py:143
msgid "Disable services"
msgstr "Desativar serviços"

#: lib/main_configurator.py:144
msgid ""
"List services to disable at boot, separated by commas.\n"
"\n"
"• Example: 'bluetooth, ModemManager'.\n"
"• systemd units and sysvinit script names are supported."
msgstr ""
"Liste os serviços para desabilitar na inicialização, separados por vírgulas.\n"
"\n"
"• Exemplo: 'bluetooth, ModemManager'.\n"
"• Nomes de unidades systemd e scripts sysvinit são suportados."

#: lib/main_configurator.py:148
msgid "Security"
msgstr "Segurança"

#: lib/main_configurator.py:149
msgid "Security preset"
msgstr "Predefinição de segurança"

#: lib/main_configurator.py:150
msgid "Choose a preset to fill the settings below. You can customize any setting afterward. Only the individual settings are saved."
msgstr "Escolha uma predefinição para preencher as configurações abaixo. Você pode personalizar qualquer configuração depois. Somente as configurações individuais são salvas."

#: lib/main_configurator.py:151
msgid "Sudo mode"
msgstr "Modo sudo"

#: lib/main_configurator.py:152
msgid "passwordless keeps historical MiniOS behavior; password requires the user password; disabled removes the MiniOS sudo grant."
msgstr "passwordless mantém o comportamento histórico do MiniOS; password exige a senha do usuário; disabled remove a concessão de sudo do MiniOS."

#: lib/main_configurator.py:153
msgid "PolicyKit mode"
msgstr "Modo PolicyKit"

#: lib/main_configurator.py:154
msgid "passwordless keeps historical MiniOS GUI admin convenience; password/disabled remove that rule and use normal PolicyKit authentication."
msgstr "passwordless mantém a conveniência administrativa da interface gráfica do MiniOS; password/disabled removem essa regra e utilizam a autenticação padrão do PolicyKit."

#: lib/main_configurator.py:155
msgid "SSH root login"
msgstr "Login root via SSH"

#: lib/main_configurator.py:156
msgid "Allow or deny root login through OpenSSH."
msgstr "Permitir ou negar login root pelo OpenSSH."

#: lib/main_configurator.py:157
msgid "SSH password authentication"
msgstr "Autenticação por senha via SSH"

#: lib/main_configurator.py:158
msgid "Allow or deny password authentication through OpenSSH."
msgstr "Permitir ou negar autenticação por senha pelo OpenSSH."

#: lib/main_configurator.py:159
msgid "XRDP mode"
msgstr "Modo XRDP"

#: lib/main_configurator.py:160
msgid "relaxed keeps MiniOS defaults; hardened binds to localhost and disables root login; disabled disables common XRDP service links."
msgstr "relaxed mantém os padrões do MiniOS; hardened vincula ao localhost e desabilita login root; disabled desativa os links comuns do serviço XRDP."

#: lib/main_configurator.py:161
msgid "X11 mode"
msgstr "Modo X11"

#: lib/main_configurator.py:162
msgid "relaxed keeps compatibility; hardened removes the permissive -ac launch option and tightens Xwrapper where present."
msgstr "relaxed mantém a compatibilidade; hardened remove a opção permissiva -ac no lançamento e restringe o Xwrapper onde disponível."

#: lib/main_configurator.py:163
msgid "Show password hints"
msgstr "Exibir dicas de senha"

#: lib/main_configurator.py:164
msgid "Show default root/live password hints in /etc/issue."
msgstr "Exibe dicas de senha padrão root/live em /etc/issue."

#: lib/main_configurator.py:165
msgid "Lockscreen mode"
msgstr "Modo de tela de bloqueio"

#: lib/main_configurator.py:166
msgid "relaxed keeps live-session convenience; hardened preserves/enables screen locking where supported."
msgstr "relaxed mantém a conveniência da sessão live; hardened preserva/habilita o bloqueio de tela onde suportado."

#: lib/main_configurator.py:168
msgid "Keyboard"
msgstr "Teclado"

#: lib/main_configurator.py:169
msgid "Keyboard model"
msgstr "Modelo de teclado"

#: lib/main_configurator.py:170
msgid ""
"Specify the keyboard hardware model (e.g., 'pc105').\n"
"\n"
"• Leave blank for automatic detection.\n"
"\n"
"See: man 7 live-config (search 'keyboard-model')"
msgstr ""
"Especifique o modelo de hardware do teclado (por exemplo, 'pc105').\n"
"\n"
"• Deixe em branco para detecção automática.\n"
"\n"
"Ver: man 7 live-config (procurar 'keyboard-model')"

#: lib/main_configurator.py:173
msgid "Keyboard layouts"
msgstr "Layouts de teclado"

#: lib/main_configurator.py:174
msgid ""
"List one or more keyboard layouts, separated by commas (e.g., 'us, ru').\n"
"\n"
"• Controls which layouts are available in the session.\n"
"\n"
"See: man 7 live-config (search 'keyboard-layouts')"
msgstr ""
"Liste um ou mais layouts de teclado, separados por vírgulas (por exemplo, 'us, ru').\n"
"\n"
"• Controla quais layouts estão disponíveis na sessão.\n"
"\n"
"Ver: man 7 live-config (procurar 'keyboard-layouts')"

#: lib/main_configurator.py:177
msgid "Keyboard options"
msgstr "Opções de teclado"

#: lib/main_configurator.py:178
msgid ""
"Set additional keyboard options (XKB).\n"
"\n"
"• Example: 'grp:alt_shift_toggle' to switch layouts with Alt+Shift.\n"
"\n"
"See: man 7 live-config (search 'keyboard-options')"
msgstr ""
"Defina opções adicionais do teclado (XKB).\n"
"\n"
"• Exemplo: 'grp:alt_shift_toggle' para alternar layouts com Alt+Shift.\n"
"\n"
"Ver: man 7 live-config (procurar 'keyboard-options')"

#: lib/main_configurator.py:181
msgid "Keyboard variants"
msgstr "Variantes de teclado"

#: lib/main_configurator.py:182
msgid ""
"Specify keyboard variants for chosen layouts, separated by commas.\n"
"\n"
"• Customize layout (e.g., 'dvorak' for US).\n"
"• Leave blank if not needed.\n"
"\n"
"See: man 7 live-config (search 'keyboard-variants')"
msgstr ""
"Especifique as variantes do teclado para os layouts escolhidos, separadas por vírgulas.\n"
"\n"
"• Personalize o layout (por exemplo, 'dvorak' para EUA).\n"
"• Deixe em branco se não for necessário.\n"
"\n"
"Ver: man 7 live-config (procurar 'keyboard-variants')"

#: lib/main_configurator.py:187
msgid "Advanced"
msgstr "Avançado"

#: lib/main_configurator.py:188
msgid "Module mode"
msgstr "Modo de módulo"

#: lib/main_configurator.py:189
msgid ""
"Choose how system modules are loaded:\n"
"• 'simple' – load modules as-is.\n"
"• 'merged' – consolidates dpkg databases, passwd, shadow, and groups; updates caches.\n"
"\n"
"Usually not required unless modules are built independently.\n"
"See: man 7 live-config (search 'module-mode')"
msgstr ""
"Escolha como os módulos do sistema são carregados:\n"
"• 'simple' – carrega os módulos como estão.\n"
"• 'merged' – consolida os bancos de dados dpkg, passwd, shadow e groups; atualiza os caches.\n"
"\n"
"Geralmente não é necessário, a menos que os módulos sejam construídos independentemente.\n"
"Ver: man 7 live-config (procurar 'module-mode')"

#: lib/main_configurator.py:194
msgid "live-config command line"
msgstr "Linha de comando do live-config"

#: lib/main_configurator.py:195
msgid ""
"Additional boot parameters for live-config (separated by spaces).\n"
"\n"
"• Passed at startup to control various session aspects.\n"
"• Example: 'boot=live live-config.debug'\n"
"\n"
"See: man 7 live-config (search 'cmdline')"
msgstr ""
"Parâmetros adicionais de inicialização para o live-config (separados por espaços).\n"
"\n"
"• Passados na inicialização para controlar vários aspectos da sessão.\n"
"• Exemplo: 'boot=live live-config.debug'\n"
"\n"
"Ver: man 7 live-config (procurar 'cmdline')"

#: lib/main_configurator.py:199
msgid "Debug mode"
msgstr "Modo de depuração"

#: lib/main_configurator.py:200
msgid ""
"Activate to enable detailed debug output during boot.\n"
"\n"
"• Useful for troubleshooting configuration issues.\n"
"\n"
"See: man 7 live-config (search 'debug')"
msgstr ""
"Ative para habilitar a saída detalhada de depuração durante a inicialização.\n"
"\n"
"• Útil para solucionar problemas de configuração.\n"
"\n"
"Ver: man 7 live-config (procurar 'debug')"

#: lib/main_configurator.py:203
msgid "Export logs to flash drive"
msgstr "Exportar logs para pen drive"

#: lib/main_configurator.py:204
msgid ""
"If enabled, MiniOS and live-config logs are copied to the writable MiniOS drive during every boot.\n"
"\n"
"• Each boot creates a timestamped directory under /minios/log.\n"
"• Useful for diagnostics and troubleshooting.\n"
"\n"
"See: https://github.com/minios-linux/minios-live/wiki"
msgstr ""
"Se ativado, os logs do MiniOS e do live-config são copiados para a unidade gravável do MiniOS em cada inicialização.\n"
"\n"
"• Cada inicialização cria um diretório com data e hora em /minios/log.\n"
"• Útil para diagnóstico e solução de problemas.\n"
"\n"
"Veja: https://github.com/minios-linux/minios-live/wiki"

#: lib/main_configurator.py:332
msgid "If you are unsure about a field, do not change it. Incorrect settings may prevent the system from booting."
msgstr "Se você não tiver certeza sobre um campo, não o altere. Configurações incorretas podem impedir o sistema de iniciar."

#: lib/main_configurator.py:337
msgid "LUKS persistence was requested at boot. Crypto support is provided by the initrd; this configurator does not open containers or request passwords."
msgstr "Persistência LUKS foi solicitada na inicialização. O suporte a criptografia é fornecido pelo initrd; este configurador não abre contêineres nem solicita senhas."

#: lib/main_configurator.py:342
msgid "LUKS persistence was requested at boot, but this initrd does not advertise crypto support. It cannot be activated until a crypto-capable initrd provides /run/initramfs/etc/minios-initramfs-crypt."
msgstr "Persistência LUKS foi solicitada na inicialização, mas este initrd não oferece suporte a criptografia. Ela não pode ser ativada até que um initrd com suporte a criptografia forneça /run/initramfs/etc/minios-initramfs-crypt."

#: lib/main_configurator.py:397
msgid "Detect current hostname, locale, timezone, and boot target."
msgstr "Detectar hostname, localidade, fuso horário e alvo de boot atuais."

#: lib/main_configurator.py:398
msgid "Detect current system settings"
msgstr "Detectar as configurações atuais do sistema"

#: lib/main_configurator.py:400
msgid "Detect the keyboard settings used by the current session."
msgstr "Detectar as configurações de teclado utilizadas na sessão atual."

#: lib/main_configurator.py:401
msgid "Detect current keyboard"
msgstr "Detectar teclado atual"

#: lib/main_configurator.py:433
msgid "Preset only; individual settings are saved"
msgstr "Apenas predefinição; configurações individuais são salvas"

#: lib/main_configurator.py:436
msgid "Applies after reboot"
msgstr "Aplica após reinicialização"

#: lib/main_configurator.py:437
msgid "Only when creating a new session"
msgstr "Somente ao criar uma nova sessão"

#: lib/main_configurator.py:479 lib/main_configurator.py:495
msgid "Show password"
msgstr "Mostrar senha"

#: lib/main_configurator.py:495
msgid "Hide password"
msgstr "Ocultar senha"

#: lib/main_configurator.py:505 lib/main_configurator.py:508
#: lib/main_configurator.py:509
msgid "Automatic"
msgstr "Automático"

#: lib/main_configurator.py:506 lib/main_configurator.py:507
msgid "Use system default"
msgstr "Usar padrão do sistema"

#: lib/main_configurator.py:510 lib/main_configurator.py:511
#: lib/main_configurator.py:512 lib/main_configurator.py:513
#: lib/main_configurator.py:514
msgid "None"
msgstr "Nenhum"

#: lib/main_configurator.py:536
msgid "Enabled"
msgstr "Ativado"

#: lib/main_configurator.py:537
msgid "Disabled"
msgstr "Desativado"

#: lib/main_configurator.py:577
msgid "Custom"
msgstr "Personalizado"

#: lib/main_configurator.py:602
msgid "XRDP is not installed. This setting will be saved and used if XRDP is installed later."
msgstr "XRDP não está instalado. Esta configuração será salva e usada caso o XRDP seja instalado posteriormente."

#: lib/main_configurator.py:627
msgid "Discard changes…"
msgstr "Descartar alterações…"

#: lib/main_configurator.py:630 lib/main_configurator.py:987
msgid "Review changes"
msgstr "Revisar alterações"

#: lib/main_configurator.py:633
msgid "Save changes"
msgstr "Salvar alterações"

#: lib/main_configurator.py:732
msgid "This value is not valid."
msgstr "Este valor não é válido."

#: lib/main_configurator.py:748
msgid "No unsaved changes"
msgstr "Nenhuma alteração não salva"

#: lib/main_configurator.py:750
