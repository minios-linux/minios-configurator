#: lib/config_state.py:60 lib/config_state.py:61
msgid "Password unchanged"
msgstr "Passwort nicht geändert"

#: lib/config_state.py:61
msgid "Password will be changed"
msgstr "Passwort wird geändert"

#: lib/config_utils.py:43 lib/config_utils.py:70
msgid "Config file must be a regular file."
msgstr "Die Konfigurationsdatei muss eine reguläre Datei sein."

#: lib/config_utils.py:57
msgid "Failed to load config: {}"
msgstr "Konfiguration konnte nicht geladen werden: {}"

#: lib/config_utils.py:139
msgid "Failed to update config: {}"
msgstr "Konfiguration konnte nicht aktualisiert werden: {}"

#: lib/main_configurator.py:71
msgid "User"
msgstr "Benutzer"

#: lib/main_configurator.py:72
msgid "Username"
msgstr "Benutzername"

#: lib/main_configurator.py:73
msgid ""
"Set the default username for the live session.\n"
"\n"
"• This user is created automatically at boot.\n"
"\n"
"See: man 7 live-config (search 'username')"
msgstr ""
"Legen Sie den Standard-Benutzernamen für die Live-Sitzung fest.\n"
"\n"
"• Dieser Benutzer wird beim Start automatisch erstellt.\n"
"\n"
"Siehe: man 7 live-config (Suche 'username')"

#: lib/main_configurator.py:76
msgid "Full name"
msgstr "Vollständiger Name"

#: lib/main_configurator.py:77
msgid ""
"Enter the full name for the default user.\n"
"\n"
"• Used for display purposes (e.g., on login screens).\n"
"\n"
"See: man 7 live-config (search 'user-fullname')"
msgstr ""
"Geben Sie den vollständigen Namen für den Standardbenutzer ein.\n"
"\n"
"• Wird für Anzeigezwecke verwendet (z. B. auf Anmeldebildschirmen).\n"
"\n"
"Siehe: man 7 live-config (Suche 'user-fullname')"

#: lib/main_configurator.py:80
msgid "User groups"
msgstr "Benutzergruppen"

#: lib/main_configurator.py:81
msgid ""
"Specify additional groups for the user, separated by commas or spaces.\n"
"\n"
"• Grants access to devices and features (e.g., 'audio, video, plugdev').\n"
"\n"
"See: man 7 live-config (search 'user-default-groups')"
msgstr ""
"Geben Sie zusätzliche Gruppen für den Benutzer an, getrennt durch Kommas oder Leerzeichen.\n"
"\n"
"• Gewährt Zugriff auf Geräte und Funktionen (z. B. 'audio, video, plugdev').\n"
"\n"
"Siehe: man 7 live-config (Suche 'user-default-groups')"

#: lib/main_configurator.py:84
msgid "User password"
msgstr "Benutzerpasswort"

#: lib/main_configurator.py:85
msgid ""
"Set the initial password for the default user.\n"
"\n"
"• Leave blank to keep the existing password.\n"
"• Spaces are not allowed.\n"
"\n"
"See: man 7 live-config (search 'user-password')"
msgstr ""
"Legen Sie das anfängliche Passwort für den Standardbenutzer fest.\n"
"\n"
"• Leer lassen, um das vorhandene Passwort zu behalten.\n"
"• Leerzeichen sind nicht erlaubt.\n"
"\n"
"Siehe: man 7 live-config (Suche 'user-password')"

#: lib/main_configurator.py:89
msgid "Root password"
msgstr "Root-Passwort"

#: lib/main_configurator.py:90
msgid ""
"Set the initial password for the root (administrator) account.\n"
"\n"
"• Leave blank to keep the existing password.\n"
"• Spaces are not allowed; ignored if 'No-root mode' is enabled.\n"
"\n"
"See: man 7 live-config (search 'root-password')"
msgstr ""
"Legen Sie das anfängliche Passwort für das Root-Konto (Administrator) fest.\n"
"\n"
"• Leer lassen, um das vorhandene Passwort zu behalten.\n"
"• Leerzeichen sind nicht erlaubt; ignoriert, wenn der 'Kein-Root-Modus' aktiviert ist.\n"
"\n"
"Siehe: man 7 live-config (Suche 'root-password')"

#: lib/main_configurator.py:94
msgid "Link user directories to storage"
msgstr "Benutzerverzeichnisse mit Speicher verknüpfen"

#: lib/main_configurator.py:95
msgid ""
"If enabled, user home directories will be symlinked to persistent storage.\n"
"\n"
"• Uses the FAT32, exFAT, or NTFS MiniOS drive.\n"
"• Unavailable with toram, toram=full, and toram=trim.\n"
"• Conflicting non-empty folders are never merged automatically.\n"
"\n"
"See: man 7 live-config (search 'link-user-dirs')"
msgstr ""
"Wenn aktiviert, werden die Home-Verzeichnisse der Benutzer als Symlinks auf den persistenten Speicher verknüpft.\n"
"\n"
"• Verwendet das FAT32-, exFAT- oder NTFS-MiniOS-Laufwerk.\n"
"• Nicht verfügbar mit toram, toram=full und toram=trim.\n"
"• Konfliktbehaftete, nicht-leere Ordner werden niemals automatisch zusammengeführt.\n"
"\n"
"Siehe: man 7 live-config (Suche nach 'link-user-dirs')"

#: lib/main_configurator.py:100
msgid "Bind user directories to storage"
msgstr "Benutzerverzeichnisse an Speicher binden"

#: lib/main_configurator.py:101
msgid ""
"If enabled, user home directories will be bind-mounted to persistent storage.\n"
"\n"
"• Uses the FAT32, exFAT, or NTFS MiniOS drive.\n"
"• Unavailable with toram, toram=full, and toram=trim.\n"
"• Conflicting non-empty folders are never merged automatically.\n"
"\n"
"See: man 7 live-config (search 'bind-user-dirs')"
msgstr ""
"Wenn aktiviert, werden die Home-Verzeichnisse der Benutzer per Bind-Mount auf den persistenten Speicher eingebunden.\n"
"\n"
"• Verwendet das FAT32-, exFAT- oder NTFS-MiniOS-Laufwerk.\n"
"• Nicht verfügbar mit toram, toram=full und toram=trim.\n"
"• Konfliktbehaftete, nicht-leere Ordner werden niemals automatisch zusammengeführt.\n"
"\n"
"Siehe: man 7 live-config (Suche nach 'bind-user-dirs')"

#: lib/main_configurator.py:106
msgid "User directories path on storage"
msgstr "Pfad der Benutzerverzeichnisse auf dem Speicher"

#: lib/main_configurator.py:107
msgid ""
"Set the base path on persistent storage for user directories.\n"
"\n"
"• Example: '/minios/userdirs'.\n"
"\n"
"• The path must stay inside the MiniOS drive; '.', '..', and empty segments are not allowed.\n"
"\n"
"See: man 7 live-config (search 'user-dirs-path')"
msgstr ""
"Legt den Basispfad auf dem persistenten Speicher für Benutzerverzeichnisse fest.\n"
"\n"
"• Beispiel: '/minios/userdirs'.\n"
"\n"
"• Der Pfad muss sich innerhalb des MiniOS-Laufwerks befinden; '.', '..' und leere Segmente sind nicht erlaubt.\n"
"\n"
"Siehe: man 7 live-config (Suche nach 'user-dirs-path')"

#: lib/main_configurator.py:112
msgid "System"
msgstr "System"

#: lib/main_configurator.py:113
msgid "No-root mode"
msgstr "Kein-Root-Modus"

#: lib/main_configurator.py:114
msgid ""
"If enabled, disables the root account, enhancing security.\n"
"\n"
"• Prevents root login and administrator access.\n"
"• Ideal for live sessions.\n"
"\n"
"See: man 7 live-config (search 'noroot')"
msgstr ""
"Wenn aktiviert, wird das Root-Konto deaktiviert, was die Sicherheit erhöht.\n"
"\n"
"• Verhindert Root-Anmeldung und Administratorzugriff.\n"
"• Ideal für Live-Sitzungen.\n"
"\n"
"Siehe: man 7 live-config (Suche 'noroot')"

#: lib/main_configurator.py:118
msgid "Hostname"
msgstr "Hostname"

#: lib/main_configurator.py:119
msgid ""
"Set the computer's network name (hostname).\n"
"\n"
"• Allowed characters: letters, numbers, hyphens.\n"
"• Example: 'minios-pc'.\n"
"\n"
"See: man 7 live-config (search 'hostname')"
msgstr ""
"Legen Sie den Netzwerknamen des Computers (Hostname) fest.\n"
"\n"
"• Erlaubte Zeichen: Buchstaben, Zahlen, Bindestriche.\n"
"• Beispiel: 'minios-pc'.\n"
"\n"
"Siehe: man 7 live-config (Suche 'hostname')"

#: lib/main_configurator.py:123
msgid "Locales"
msgstr "Sprachumgebungen"

#: lib/main_configurator.py:124
msgid ""
"Set system language(s) and regional settings.\n"
"\n"
"• Enter locale codes separated by commas (e.g. 'de_DE.UTF-8, en_US.UTF-8').\n"
"• The first locale is treated as default.\n"
"\n"
"See: man 7 live-config (search 'locales')"
msgstr ""
"Legen Sie die Systemsprache(n) und regionalen Einstellungen fest.\n"
"\n"
"• Geben Sie Sprachcodes durch Kommas getrennt ein (z. B. 'de_DE.UTF-8, en_US.UTF-8').\n"
"• Die erste Sprachumgebung wird als Standard behandelt.\n"
"\n"
"Siehe: man 7 live-config (Suche 'locales')"

#: lib/main_configurator.py:128
msgid "Timezone"
msgstr "Zeitzone"

#: lib/main_configurator.py:129
msgid ""
"Set the system timezone (e.g., 'Europe/Berlin', 'America/New_York').\n"
"\n"
"• Affects system clock and displayed times.\n"
"\n"
"See: man 7 live-config (search 'timezone')"
msgstr ""
"Legen Sie die Systemzeitzone fest (z. B. 'Europe/Berlin', 'America/New_York').\n"
"\n"
"• Beeinflusst die Systemuhr und die angezeigten Zeiten.\n"
"\n"
"Siehe: man 7 live-config (Suche 'timezone')"

#: lib/main_configurator.py:132
msgid "Default boot target"
msgstr "Standard-Boot-Ziel"

#: lib/main_configurator.py:133
msgid ""
"Set the default boot target:\n"
"• 'graphical.target' – start with a desktop.\n"
"• 'multi-user.target' – console mode.\n"
"• 'rescue.target' – minimal rescue mode.\n"
"\n"
"Short aliases like 'graphical' and 'multi-user' are accepted."
msgstr ""
"Standard-Boot-Ziel festlegen:\n"
"• 'graphical.target' – startet mit Desktop.\n"
"• 'multi-user.target' – Konsolenmodus.\n"
"• 'rescue.target' – minimaler Rettungsmodus.\n"
"\n"
"Kurze Aliase wie 'graphical' und 'multi-user' werden akzeptiert."

#: lib/main_configurator.py:138
msgid "Enable services"
msgstr "Dienste aktivieren"

#: lib/main_configurator.py:139
msgid ""
"List services to enable at boot, separated by commas.\n"
"\n"
"• Example: 'ssh, NetworkManager'.\n"
"• systemd units and sysvinit script names are supported."
msgstr ""
"Liste der Dienste, die beim Booten aktiviert werden sollen, durch Kommas getrennt.\n"
"\n"
"• Beispiel: 'ssh, NetworkManager'.\n"
"• systemd-Units und sysvinit-Skriptnamen werden unterstützt."

#: lib/main_configurator.py:142
msgid "Disable services"
msgstr "Dienste deaktivieren"

#: lib/main_configurator.py:143
msgid ""
"List services to disable at boot, separated by commas.\n"
"\n"
"• Example: 'bluetooth, ModemManager'.\n"
"• systemd units and sysvinit script names are supported."
msgstr ""
"Liste der Dienste, die beim Booten deaktiviert werden sollen, durch Kommas getrennt.\n"
"\n"
"• Beispiel: 'bluetooth, ModemManager'.\n"
"• systemd-Units und sysvinit-Skriptnamen werden unterstützt."

#: lib/main_configurator.py:147
msgid "Security"
msgstr "Sicherheit"

#: lib/main_configurator.py:148
msgid "Security preset"
msgstr "Sicherheitsvorgabe"

#: lib/main_configurator.py:149
msgid "Choose a preset to fill the settings below. You can customize any setting afterward. Only the individual settings are saved."
msgstr "Wählen Sie eine Vorgabe, um die untenstehenden Einstellungen auszufüllen. Sie können jede Einstellung anschließend individuell anpassen. Es werden nur die einzelnen Einstellungen gespeichert."

#: lib/main_configurator.py:150
msgid "Sudo mode"
msgstr "Sudo-Modus"

#: lib/main_configurator.py:151
msgid "passwordless keeps historical MiniOS behavior; password requires the user password; disabled removes the MiniOS sudo grant."
msgstr "Passwortlos behält das bisherige MiniOS-Verhalten bei; Passwort erfordert das Benutzerpasswort; deaktiviert entfernt die MiniOS-Sudo-Berechtigung."

#: lib/main_configurator.py:152
msgid "PolicyKit mode"
msgstr "PolicyKit-Modus"

#: lib/main_configurator.py:153
msgid "passwordless keeps historical MiniOS GUI admin convenience; password/disabled remove that rule and use normal PolicyKit authentication."
msgstr "Passwortlos behält die bisherige MiniOS-GUI-Admin-Bequemlichkeit; Passwort/deaktiviert entfernen diese Regel und nutzen die normale PolicyKit-Authentifizierung."

#: lib/main_configurator.py:154
msgid "SSH root login"
msgstr "SSH-Root-Login"

#: lib/main_configurator.py:155
msgid "Allow or deny root login through OpenSSH."
msgstr "Root-Login über OpenSSH erlauben oder verweigern."

#: lib/main_configurator.py:156
msgid "SSH password authentication"
msgstr "SSH-Passwort-Authentifizierung"

#: lib/main_configurator.py:157
msgid "Allow or deny password authentication through OpenSSH."
msgstr "Passwort-Authentifizierung über OpenSSH erlauben oder verweigern."

#: lib/main_configurator.py:158
msgid "XRDP mode"
msgstr "XRDP-Modus"

#: lib/main_configurator.py:159
msgid "relaxed keeps MiniOS defaults; hardened binds to localhost and disables root login; disabled disables common XRDP service links."
msgstr "Entspannt behält die MiniOS-Standardeinstellungen; gehärtet bindet an localhost und deaktiviert Root-Login; deaktiviert schaltet übliche XRDP-Service-Links ab."

#: lib/main_configurator.py:160
msgid "X11 mode"
msgstr "X11-Modus"

#: lib/main_configurator.py:161
msgid "relaxed keeps compatibility; hardened removes the permissive -ac launch option and tightens Xwrapper where present."
msgstr "Entspannt erhält die Kompatibilität; gehärtet entfernt die permissive -ac-Startoption und verschärft Xwrapper, wo vorhanden."

#: lib/main_configurator.py:162
msgid "Show password hints"
msgstr "Passworthinweise anzeigen"

#: lib/main_configurator.py:163
msgid "Show default root/live password hints in /etc/issue."
msgstr "Standard-Root/Live-Passworthinweise in /etc/issue anzeigen."

#: lib/main_configurator.py:164
msgid "Lockscreen mode"
msgstr "Sperrbildschirm-Modus"

#: lib/main_configurator.py:165
msgid "relaxed keeps live-session convenience; hardened preserves/enables screen locking where supported."
msgstr "Entspannt behält den Komfort der Live-Session; gehärtet aktiviert/erhält die Bildschirmsperre, wo unterstützt."

#: lib/main_configurator.py:167
msgid "Keyboard"
msgstr "Tastatur"

#: lib/main_configurator.py:168
msgid "Keyboard model"
msgstr "Tastaturmodell"

#: lib/main_configurator.py:169
msgid ""
"Specify the keyboard hardware model (e.g., 'pc105').\n"
"\n"
"• Leave blank for automatic detection.\n"
"\n"
"See: man 7 live-config (search 'keyboard-model')"
msgstr ""
"Geben Sie das Hardwaremodell der Tastatur an (z. B. 'pc105').\n"
"\n"
"• Für die automatische Erkennung leer lassen.\n"
"\n"
"Siehe: man 7 live-config (Suche 'keyboard-model')"

#: lib/main_configurator.py:172
msgid "Keyboard layouts"
msgstr "Tastaturlayouts"

#: lib/main_configurator.py:173
msgid ""
"List one or more keyboard layouts, separated by commas (e.g., 'us, ru').\n"
"\n"
"• Controls which layouts are available in the session.\n"
"\n"
"See: man 7 live-config (search 'keyboard-layouts')"
msgstr ""
"Listen Sie ein oder mehrere Tastaturlayouts auf, getrennt durch Kommas (z. B. 'us, ru').\n"
"\n"
"• Steuert, welche Layouts in der Sitzung verfügbar sind.\n"
"\n"
"Siehe: man 7 live-config (Suche 'keyboard-layouts')"

#: lib/main_configurator.py:176
msgid "Keyboard options"
msgstr "Tastaturoptionen"

#: lib/main_configurator.py:177
msgid ""
"Set additional keyboard options (XKB).\n"
"\n"
"• Example: 'grp:alt_shift_toggle' to switch layouts with Alt+Shift.\n"
"\n"
"See: man 7 live-config (search 'keyboard-options')"
msgstr ""
"Legen Sie zusätzliche Tastaturoptionen fest (XKB).\n"
"\n"
"• Beispiel: 'grp:alt_shift_toggle' zum Wechseln der Layouts mit Alt+Umschalt.\n"
"\n"
"Siehe: man 7 live-config (Suche 'keyboard-options')"

#: lib/main_configurator.py:180
msgid "Keyboard variants"
msgstr "Tastaturvarianten"

#: lib/main_configurator.py:181
msgid ""
"Specify keyboard variants for chosen layouts, separated by commas.\n"
"\n"
"• Customize layout (e.g., 'dvorak' for US).\n"
"• Leave blank if not needed.\n"
"\n"
"See: man 7 live-config (search 'keyboard-variants')"
msgstr ""
"Geben Sie Tastaturvarianten für ausgewählte Layouts an, getrennt durch Kommas.\n"
"\n"
"• Anpassen des Layouts (z. B. 'dvorak' für US).\n"
"• Leer lassen, wenn nicht benötigt.\n"
"\n"
"Siehe: man 7 live-config (Suche 'keyboard-variants')"

#: lib/main_configurator.py:186
msgid "Advanced"
msgstr "Erweitert"

#: lib/main_configurator.py:187
msgid "Module mode"
msgstr "Modulmodus"

#: lib/main_configurator.py:188
msgid ""
"Choose how system modules are loaded:\n"
"• 'simple' – load modules as-is.\n"
"• 'merged' – consolidates dpkg databases, passwd, shadow, and groups; updates caches.\n"
"\n"
"Usually not required unless modules are built independently.\n"
"See: man 7 live-config (search 'module-mode')"
msgstr ""
"Wählen Sie, wie Systemmodule geladen werden:\n"
"• 'simple' – Module werden wie vorhanden geladen.\n"
"• 'merged' – konsolidiert dpkg-Datenbanken, passwd, shadow und groups; aktualisiert Caches.\n"
"\n"
"Normalerweise nicht erforderlich, es sei denn, Module werden unabhängig erstellt.\n"
"Siehe: man 7 live-config (Suche 'module-mode')"

#: lib/main_configurator.py:193
msgid "live-config command line"
msgstr "live-config-Befehlszeile"

#: lib/main_configurator.py:194
msgid ""
"Additional boot parameters for live-config (separated by spaces).\n"
"\n"
"• Passed at startup to control various session aspects.\n"
"• Example: 'boot=live live-config.debug'\n"
"\n"
"See: man 7 live-config (search 'cmdline')"
msgstr ""
"Zusätzliche Boot-Parameter für live-config (durch Leerzeichen getrennt).\n"
"\n"
"• Werden beim Start übergeben, um verschiedene Aspekte der Sitzung zu steuern.\n"
"• Beispiel: 'boot=live live-config.debug'\n"
"\n"
"Siehe: man 7 live-config (Suche 'cmdline')"

#: lib/main_configurator.py:198
msgid "Debug mode"
msgstr "Debug-Modus"

#: lib/main_configurator.py:199
msgid ""
"Activate to enable detailed debug output during boot.\n"
"\n"
"• Useful for troubleshooting configuration issues.\n"
"\n"
"See: man 7 live-config (search 'debug')"
msgstr ""
"Aktivieren Sie, um detaillierte Debug-Ausgabe während des Starts zu ermöglichen.\n"
"\n"
"• Nützlich zur Fehlerbehebung bei Konfigurationsproblemen.\n"
"\n"
"Siehe: man 7 live-config (Suche 'debug')"

#: lib/main_configurator.py:202
msgid "Export logs to flash drive"
msgstr "Protokolle auf USB-Stick exportieren"

#: lib/main_configurator.py:203
msgid ""
"If enabled, MiniOS and live-config logs are copied to the writable MiniOS drive during every boot.\n"
"\n"
"• Each boot creates a timestamped directory under /minios/log.\n"
"• Useful for diagnostics and troubleshooting.\n"
"\n"
"See: https://github.com/minios-linux/minios-live/wiki"
msgstr ""
"Wenn aktiviert, werden MiniOS- und live-config-Logs bei jedem Systemstart auf das beschreibbare MiniOS-Laufwerk kopiert.\n"
"\n"
"• Bei jedem Start wird ein Verzeichnis mit Zeitstempel unter /minios/log angelegt.\n"
"• Nützlich für Diagnose und Fehlerbehebung.\n"
"\n"
"Siehe: https://github.com/minios-linux/minios-live/wiki"

#: lib/main_configurator.py:237 lib/main_configurator.py:296
#: share/applications/minios-configurator.desktop:4
msgid "MiniOS Configurator"
msgstr "MiniOS-Konfigurator"

#: lib/main_configurator.py:322
msgid "If you are unsure about a field, do not change it. Incorrect settings may prevent the system from booting."
msgstr "Wenn Sie sich bei einem Feld unsicher sind, ändern Sie es nicht. Falsche Einstellungen können das Starten des Systems verhindern."

#: lib/main_configurator.py:327
msgid "LUKS persistence encryption was requested at boot. Crypto support is provided by the initrd; this configurator does not open containers or request passwords."
msgstr "LUKS-Persistenzverschlüsselung wurde beim Systemstart angefordert. Die Kryptounterstützung wird vom initrd bereitgestellt; dieser Konfigurator öffnet keine Container und fordert keine Passwörter an."

#: lib/main_configurator.py:332
msgid "LUKS persistence encryption was requested at boot, but this initrd does not advertise the layered crypto capability. It cannot be activated until a crypto-capable initrd provides /run/initramfs/etc/minios-initramfs-crypt."
msgstr "LUKS-Persistenzverschlüsselung wurde beim Systemstart angefordert, aber dieses initrd bietet keine Unterstützung für die gestapelte Kryptofunktionalität. Sie kann erst aktiviert werden, wenn ein kryptofähiges initrd /run/initramfs/etc/minios-initramfs-crypt bereitstellt."

#: lib/main_configurator.py:385
msgid "Detect current hostname, locale, timezone, and boot target."
msgstr "Erkennt aktuellen Hostnamen, Spracheinstellung, Zeitzone und Boot-Ziel."

#: lib/main_configurator.py:386
msgid "Detect current system settings"
msgstr "Erkennt aktuelle Systemeinstellungen"

#: lib/main_configurator.py:388
msgid "Detect the keyboard settings used by the current session."
msgstr "Erkennt die Tastatureinstellungen der aktuellen Sitzung."

#: lib/main_configurator.py:389
msgid "Detect current keyboard"
msgstr "Erkennt aktuelle Tastatur"

#: lib/main_configurator.py:417
msgid "Preset only; individual settings are saved"
msgstr "Nur Vorgabe; einzelne Einstellungen werden gespeichert"

#: lib/main_configurator.py:420
msgid "Applies after reboot"
msgstr "Wird nach dem Neustart angewendet"

#: lib/main_configurator.py:421
msgid "Only when creating a new session"
msgstr "Nur beim Erstellen einer neuen Sitzung"

#: lib/main_configurator.py:457
msgid "Show password"
msgstr "Passwort anzeigen"

#: lib/main_configurator.py:458
msgid "Hide password"
msgstr "Passwort ausblenden"

#: lib/main_configurator.py:476 lib/main_configurator.py:479
#: lib/main_configurator.py:480
msgid "Automatic"
msgstr "Automatisch"

#: lib/main_configurator.py:477 lib/main_configurator.py:478
msgid "Use system default"
msgstr "Systemstandard verwenden"

#: lib/main_configurator.py:481 lib/main_configurator.py:482
#: lib/main_configurator.py:483 lib/main_configurator.py:484
#: lib/main_configurator.py:485
msgid "None"
