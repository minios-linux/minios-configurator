#: lib/config_state.py:60 lib/config_state.py:61
msgid "Password unchanged"
msgstr "Password invariata"

#: lib/config_state.py:61
msgid "Password will be changed"
msgstr "La password verrà modificata"

#: lib/config_utils.py:43 lib/config_utils.py:70
msgid "Config file must be a regular file."
msgstr "Il file di configurazione deve essere un file regolare."

#: lib/config_utils.py:57
msgid "Failed to load config: {}"
msgstr "Impossibile caricare la configurazione: {}"

#: lib/config_utils.py:139
msgid "Failed to update config: {}"
msgstr "Impossibile aggiornare la configurazione: {}"

#: lib/main_configurator.py:71
msgid "User"
msgstr "Utente"

#: lib/main_configurator.py:72
msgid "Username"
msgstr "Nome utente"

#: lib/main_configurator.py:73
msgid ""
"Set the default username for the live session.\n"
"\n"
"• This user is created automatically at boot.\n"
"\n"
"See: man 7 live-config (search 'username')"
msgstr ""
"Imposta il nome utente predefinito per la sessione live.\n"
"\n"
"• Questo utente viene creato automaticamente all'avvio.\n"
"\n"
"Vedi: man 7 live-config (cerca 'username')"

#: lib/main_configurator.py:76
msgid "Full name"
msgstr "Nome completo"

#: lib/main_configurator.py:77
msgid ""
"Enter the full name for the default user.\n"
"\n"
"• Used for display purposes (e.g., on login screens).\n"
"\n"
"See: man 7 live-config (search 'user-fullname')"
msgstr ""
"Inserisci il nome completo per l'utente predefinito.\n"
"\n"
"• Utilizzato per scopi di visualizzazione (ad esempio, nelle schermate di accesso).\n"
"\n"
"Vedi: man 7 live-config (cerca 'user-fullname')"

#: lib/main_configurator.py:80
msgid "User groups"
msgstr "Gruppi utente"

#: lib/main_configurator.py:81
msgid ""
"Specify additional groups for the user, separated by commas or spaces.\n"
"\n"
"• Grants access to devices and features (e.g., 'audio, video, plugdev').\n"
"\n"
"See: man 7 live-config (search 'user-default-groups')"
msgstr ""
"Specifica gruppi aggiuntivi per l'utente, separati da virgole o spazi.\n"
"\n"
"• Concede l'accesso a dispositivi e funzionalità (ad esempio, 'audio, video, plugdev').\n"
"\n"
"Vedi: man 7 live-config (cerca 'user-default-groups')"

#: lib/main_configurator.py:84
msgid "User password"
msgstr "Password utente"

#: lib/main_configurator.py:85
msgid ""
"Set the initial password for the default user.\n"
"\n"
"• Leave blank to keep the existing password.\n"
"• Spaces are not allowed.\n"
"\n"
"See: man 7 live-config (search 'user-password')"
msgstr ""
"Imposta la password iniziale per l'utente predefinito.\n"
"\n"
"• Lascia vuoto per mantenere la password esistente.\n"
"• Gli spazi non sono ammessi.\n"
"\n"
"Vedi: man 7 live-config (cerca 'user-password')"

#: lib/main_configurator.py:89
msgid "Root password"
msgstr "Password root"

#: lib/main_configurator.py:90
msgid ""
"Set the initial password for the root (administrator) account.\n"
"\n"
"• Leave blank to keep the existing password.\n"
"• Spaces are not allowed; ignored if 'No-root mode' is enabled.\n"
"\n"
"See: man 7 live-config (search 'root-password')"
msgstr ""
"Imposta la password iniziale per l'account root (amministratore).\n"
"\n"
"• Lascia vuoto per mantenere la password esistente.\n"
"• Gli spazi non sono ammessi; ignorato se la 'Modalità senza root' è abilitata.\n"
"\n"
"Vedi: man 7 live-config (cerca 'root-password')"

#: lib/main_configurator.py:94
msgid "Link user directories to storage"
msgstr "Collega le directory utente allo storage"

#: lib/main_configurator.py:95
msgid ""
"If enabled, user home directories will be symlinked to persistent storage.\n"
"\n"
"• Uses the FAT32, exFAT, or NTFS MiniOS drive.\n"
"• Unavailable with toram, toram=full, and toram=trim.\n"
"• Conflicting non-empty folders are never merged automatically.\n"
"\n"
"See: man 7 live-config (search 'link-user-dirs')"
msgstr ""
"Se abilitato, le home directory degli utenti verranno collegate tramite symlink allo storage persistente.\n"
"\n"
"• Utilizza il drive MiniOS FAT32, exFAT o NTFS.\n"
"• Non disponibile con toram, toram=full e toram=trim.\n"
"• Le cartelle in conflitto e non vuote non vengono mai unite automaticamente.\n"
"\n"
"Vedi: man 7 live-config (cerca 'link-user-dirs')"

#: lib/main_configurator.py:100
msgid "Bind user directories to storage"
msgstr "Monta le directory utente su storage"

#: lib/main_configurator.py:101
msgid ""
"If enabled, user home directories will be bind-mounted to persistent storage.\n"
"\n"
"• Uses the FAT32, exFAT, or NTFS MiniOS drive.\n"
"• Unavailable with toram, toram=full, and toram=trim.\n"
"• Conflicting non-empty folders are never merged automatically.\n"
"\n"
"See: man 7 live-config (search 'bind-user-dirs')"
msgstr ""
"Se abilitato, le home directory degli utenti verranno montate tramite bind su storage persistente.\n"
"\n"
"• Utilizza il drive MiniOS FAT32, exFAT o NTFS.\n"
"• Non disponibile con toram, toram=full e toram=trim.\n"
"• Le cartelle in conflitto e non vuote non vengono mai unite automaticamente.\n"
"\n"
"Vedi: man 7 live-config (cerca 'bind-user-dirs')"

#: lib/main_configurator.py:106
msgid "User directories path on storage"
msgstr "Percorso directory utente su storage"

#: lib/main_configurator.py:107
msgid ""
"Set the base path on persistent storage for user directories.\n"
"\n"
"• Example: '/minios/userdirs'.\n"
"\n"
"• The path must stay inside the MiniOS drive; '.', '..', and empty segments are not allowed.\n"
"\n"
"See: man 7 live-config (search 'user-dirs-path')"
msgstr ""
"Imposta il percorso base sullo storage persistente per le directory utente.\n"
"\n"
"• Esempio: '/minios/userdirs'.\n"
"\n"
"• Il percorso deve rimanere all'interno del drive MiniOS; '.', '..' e segmenti vuoti non sono ammessi.\n"
"\n"
"Vedi: man 7 live-config (cerca 'user-dirs-path')"

#: lib/main_configurator.py:112
msgid "System"
msgstr "Sistema"

#: lib/main_configurator.py:113
msgid "No-root mode"
msgstr "Modalità senza root"

#: lib/main_configurator.py:114
msgid ""
"If enabled, disables the root account, enhancing security.\n"
"\n"
"• Prevents root login and administrator access.\n"
"• Ideal for live sessions.\n"
"\n"
"See: man 7 live-config (search 'noroot')"
msgstr ""
"Se abilitato, disabilita l'account root, migliorando la sicurezza.\n"
"\n"
"• Impedisce l'accesso root e l'accesso amministratore.\n"
"• Ideale per le sessioni live.\n"
"\n"
"Vedi: man 7 live-config (cerca 'noroot')"

#: lib/main_configurator.py:118
msgid "Hostname"
msgstr "Nome host"

#: lib/main_configurator.py:119
msgid ""
"Set the computer's network name (hostname).\n"
"\n"
"• Allowed characters: letters, numbers, hyphens.\n"
"• Example: 'minios-pc'.\n"
"\n"
"See: man 7 live-config (search 'hostname')"
msgstr ""
"Imposta il nome di rete del computer (nome host).\n"
"\n"
"• Caratteri consentiti: lettere, numeri, trattini.\n"
"• Esempio: 'minios-pc'.\n"
"\n"
"Vedi: man 7 live-config (cerca 'hostname')"

#: lib/main_configurator.py:123
msgid "Locales"
msgstr "Lingue"

#: lib/main_configurator.py:124
msgid ""
"Set system language(s) and regional settings.\n"
"\n"
"• Enter locale codes separated by commas (e.g. 'de_DE.UTF-8, en_US.UTF-8').\n"
"• The first locale is treated as default.\n"
"\n"
"See: man 7 live-config (search 'locales')"
msgstr ""
"Imposta la/le lingua/e del sistema e le impostazioni regionali.\n"
"\n"
"• Inserisci i codici locali separati da virgole (es. 'de_DE.UTF-8, en_US.UTF-8').\n"
"• La prima impostazione locale viene trattata come predefinita.\n"
"\n"
"Vedi: man 7 live-config (cerca 'locales')"

#: lib/main_configurator.py:128
msgid "Timezone"
msgstr "Fuso orario"

#: lib/main_configurator.py:129
msgid ""
"Set the system timezone (e.g., 'Europe/Berlin', 'America/New_York').\n"
"\n"
"• Affects system clock and displayed times.\n"
"\n"
"See: man 7 live-config (search 'timezone')"
msgstr ""
"Imposta il fuso orario del sistema (es. 'Europe/Berlin', 'America/New_York').\n"
"\n"
"• Influisce sull'orologio di sistema e sugli orari visualizzati.\n"
"\n"
"Vedi: man 7 live-config (cerca 'timezone')"

#: lib/main_configurator.py:132
msgid "Default boot target"
msgstr "Destinazione di avvio predefinita"

#: lib/main_configurator.py:133
msgid ""
"Set the default boot target:\n"
"• 'graphical.target' – start with a desktop.\n"
"• 'multi-user.target' – console mode.\n"
"• 'rescue.target' – minimal rescue mode.\n"
"\n"
"Short aliases like 'graphical' and 'multi-user' are accepted."
msgstr ""
"Imposta la destinazione di avvio predefinita:\n"
"• 'graphical.target' – avvio con ambiente desktop.\n"
"• 'multi-user.target' – modalità console.\n"
"• 'rescue.target' – modalità di recupero minima.\n"
"\n"
"Sono accettati anche alias brevi come 'graphical' e 'multi-user'."

#: lib/main_configurator.py:138
msgid "Enable services"
msgstr "Abilita servizi"

#: lib/main_configurator.py:139
msgid ""
"List services to enable at boot, separated by commas.\n"
"\n"
"• Example: 'ssh, NetworkManager'.\n"
"• systemd units and sysvinit script names are supported."
msgstr ""
"Elenca i servizi da abilitare all'avvio, separati da virgole.\n"
"\n"
"• Esempio: 'ssh, NetworkManager'.\n"
"• Sono supportati nomi di unità systemd e script sysvinit."

#: lib/main_configurator.py:142
msgid "Disable services"
msgstr "Disabilita servizi"

#: lib/main_configurator.py:143
msgid ""
"List services to disable at boot, separated by commas.\n"
"\n"
"• Example: 'bluetooth, ModemManager'.\n"
"• systemd units and sysvinit script names are supported."
msgstr ""
"Elenca i servizi da disabilitare all'avvio, separati da virgole.\n"
"\n"
"• Esempio: 'bluetooth, ModemManager'.\n"
"• Sono supportati nomi di unità systemd e script sysvinit."

#: lib/main_configurator.py:147
msgid "Security"
msgstr "Sicurezza"

#: lib/main_configurator.py:148
msgid "Security preset"
msgstr "Preimpostazione di sicurezza"

#: lib/main_configurator.py:149
msgid "Choose a preset to fill the settings below. You can customize any setting afterward. Only the individual settings are saved."
msgstr "Scegli una preimpostazione per compilare le impostazioni sottostanti. Puoi personalizzare ogni impostazione in seguito. Solo le impostazioni individuali vengono salvate."

#: lib/main_configurator.py:150
msgid "Sudo mode"
msgstr "Modalità Sudo"

#: lib/main_configurator.py:151
msgid "passwordless keeps historical MiniOS behavior; password requires the user password; disabled removes the MiniOS sudo grant."
msgstr "passwordless mantiene il comportamento storico di MiniOS; password richiede la password utente; disabilitato rimuove il permesso sudo di MiniOS."

#: lib/main_configurator.py:152
msgid "PolicyKit mode"
msgstr "Modalità PolicyKit"

#: lib/main_configurator.py:153
msgid "passwordless keeps historical MiniOS GUI admin convenience; password/disabled remove that rule and use normal PolicyKit authentication."
msgstr "passwordless mantiene la comodità amministrativa storica della GUI MiniOS; password/disabilitato rimuovono questa regola e usano l'autenticazione PolicyKit standard."

#: lib/main_configurator.py:154
msgid "SSH root login"
msgstr "Accesso root SSH"

#: lib/main_configurator.py:155
msgid "Allow or deny root login through OpenSSH."
msgstr "Consenti o nega l'accesso root tramite OpenSSH."

#: lib/main_configurator.py:156
msgid "SSH password authentication"
msgstr "Autenticazione SSH con password"

#: lib/main_configurator.py:157
msgid "Allow or deny password authentication through OpenSSH."
msgstr "Consenti o nega l'autenticazione tramite password su OpenSSH."

#: lib/main_configurator.py:158
msgid "XRDP mode"
msgstr "Modalità XRDP"

#: lib/main_configurator.py:159
msgid "relaxed keeps MiniOS defaults; hardened binds to localhost and disables root login; disabled disables common XRDP service links."
msgstr "relaxed mantiene i valori predefiniti di MiniOS; hardened si lega a localhost e disabilita l'accesso root; disabilitato disattiva i collegamenti comuni del servizio XRDP."

#: lib/main_configurator.py:160
msgid "X11 mode"
msgstr "Modalità X11"

#: lib/main_configurator.py:161
msgid "relaxed keeps compatibility; hardened removes the permissive -ac launch option and tightens Xwrapper where present."
msgstr "relaxed mantiene la compatibilità; hardened rimuove l'opzione permissiva -ac all'avvio e rafforza Xwrapper dove disponibile."

#: lib/main_configurator.py:162
msgid "Show password hints"
msgstr "Mostra suggerimenti per la password"

#: lib/main_configurator.py:163
msgid "Show default root/live password hints in /etc/issue."
msgstr "Mostra i suggerimenti per la password root/live predefiniti in /etc/issue."

#: lib/main_configurator.py:164
msgid "Lockscreen mode"
msgstr "Modalità blocco schermo"

#: lib/main_configurator.py:165
msgid "relaxed keeps live-session convenience; hardened preserves/enables screen locking where supported."
msgstr "relaxed mantiene la comodità della sessione live; hardened abilita o mantiene il blocco schermo dove supportato."

#: lib/main_configurator.py:167
msgid "Keyboard"
msgstr "Tastiera"

#: lib/main_configurator.py:168
msgid "Keyboard model"
msgstr "Modello tastiera"

#: lib/main_configurator.py:169
msgid ""
"Specify the keyboard hardware model (e.g., 'pc105').\n"
"\n"
"• Leave blank for automatic detection.\n"
"\n"
"See: man 7 live-config (search 'keyboard-model')"
msgstr ""
"Specifica il modello hardware della tastiera (es. 'pc105').\n"
"\n"
"• Lascia vuoto per il rilevamento automatico.\n"
"\n"
"Vedi: man 7 live-config (cerca 'keyboard-model')"

#: lib/main_configurator.py:172
msgid "Keyboard layouts"
msgstr "Layout tastiera"

#: lib/main_configurator.py:173
msgid ""
"List one or more keyboard layouts, separated by commas (e.g., 'us, ru').\n"
"\n"
"• Controls which layouts are available in the session.\n"
"\n"
"See: man 7 live-config (search 'keyboard-layouts')"
msgstr ""
"Elenca uno o più layout di tastiera, separati da virgole (es. 'us, ru').\n"
"\n"
"• Controlla quali layout sono disponibili nella sessione.\n"
"\n"
"Vedi: man 7 live-config (cerca 'keyboard-layouts')"

#: lib/main_configurator.py:176
msgid "Keyboard options"
msgstr "Opzioni tastiera"

#: lib/main_configurator.py:177
msgid ""
"Set additional keyboard options (XKB).\n"
"\n"
"• Example: 'grp:alt_shift_toggle' to switch layouts with Alt+Shift.\n"
"\n"
"See: man 7 live-config (search 'keyboard-options')"
msgstr ""
"Imposta opzioni aggiuntive per la tastiera (XKB).\n"
"\n"
"• Esempio: 'grp:alt_shift_toggle' per cambiare layout con Alt+Shift.\n"
"\n"
"Vedi: man 7 live-config (cerca 'keyboard-options')"

#: lib/main_configurator.py:180
msgid "Keyboard variants"
msgstr "Varianti tastiera"

#: lib/main_configurator.py:181
msgid ""
"Specify keyboard variants for chosen layouts, separated by commas.\n"
"\n"
"• Customize layout (e.g., 'dvorak' for US).\n"
"• Leave blank if not needed.\n"
"\n"
"See: man 7 live-config (search 'keyboard-variants')"
msgstr ""
"Specifica le varianti della tastiera per i layout scelti, separati da virgole.\n"
"\n"
"• Personalizza il layout (es. 'dvorak' per US).\n"
"• Lascia vuoto se non necessario.\n"
"\n"
"Vedi: man 7 live-config (cerca 'keyboard-variants')"

#: lib/main_configurator.py:186
msgid "Advanced"
msgstr "Avanzato"

#: lib/main_configurator.py:187
msgid "Module mode"
msgstr "Modalità modulo"

#: lib/main_configurator.py:188
msgid ""
"Choose how system modules are loaded:\n"
"• 'simple' – load modules as-is.\n"
"• 'merged' – consolidates dpkg databases, passwd, shadow, and groups; updates caches.\n"
"\n"
"Usually not required unless modules are built independently.\n"
"See: man 7 live-config (search 'module-mode')"
msgstr ""
"Scegli come vengono caricati i moduli di sistema:\n"
"• 'simple' – carica i moduli così come sono.\n"
"• 'merged' – consolida i database dpkg, passwd, shadow e groups; aggiorna le cache.\n"
"\n"
"Di solito non è necessario a meno che i moduli non siano costruiti indipendentemente.\n"
"\n"
"Vedi: man 7 live-config (cerca 'module-mode')"

#: lib/main_configurator.py:193
msgid "live-config command line"
msgstr "Riga di comando live-config"

#: lib/main_configurator.py:194
msgid ""
"Additional boot parameters for live-config (separated by spaces).\n"
"\n"
"• Passed at startup to control various session aspects.\n"
"• Example: 'boot=live live-config.debug'\n"
"\n"
"See: man 7 live-config (search 'cmdline')"
msgstr ""
"Parametri di avvio aggiuntivi per live-config (separati da spazi).\n"
"\n"
"• Passati all'avvio per controllare vari aspetti della sessione.\n"
"• Esempio: 'boot=live live-config.debug'\n"
"\n"
"Vedi: man 7 live-config (cerca 'cmdline')"

#: lib/main_configurator.py:198
msgid "Debug mode"
msgstr "Modalità debug"

#: lib/main_configurator.py:199
msgid ""
"Activate to enable detailed debug output during boot.\n"
"\n"
"• Useful for troubleshooting configuration issues.\n"
"\n"
"See: man 7 live-config (search 'debug')"
msgstr ""
"Attiva per abilitare l'output di debug dettagliato durante l'avvio.\n"
"\n"
"• Utile per la risoluzione dei problemi di configurazione.\n"
"\n"
"Vedi: man 7 live-config (cerca 'debug')"

#: lib/main_configurator.py:202
msgid "Export logs to flash drive"
msgstr "Esporta log su chiavetta USB"

#: lib/main_configurator.py:203
msgid ""
"If enabled, MiniOS and live-config logs are copied to the writable MiniOS drive during every boot.\n"
"\n"
"• Each boot creates a timestamped directory under /minios/log.\n"
"• Useful for diagnostics and troubleshooting.\n"
"\n"
"See: https://github.com/minios-linux/minios-live/wiki"
msgstr ""
"Se abilitato, i log di MiniOS e live-config vengono copiati sull’unità MiniOS scrivibile a ogni avvio.\n"
"\n"
"• Ogni avvio crea una cartella con data e ora in /minios/log.\n"
"• Utile per diagnosi e risoluzione dei problemi.\n"
"\n"
"Vedi: https://github.com/minios-linux/minios-live/wiki"

#: lib/main_configurator.py:328
msgid "If you are unsure about a field, do not change it. Incorrect settings may prevent the system from booting."
msgstr "Se non sei sicuro di un campo, non modificarlo. Impostazioni errate possono impedire l'avvio del sistema."

#: lib/main_configurator.py:333
msgid "LUKS persistence was requested at boot. Crypto support is provided by the initrd; this configurator does not open containers or request passwords."
msgstr "La persistenza LUKS è stata richiesta all'avvio. Il supporto alla crittografia è fornito dall'initrd; questo configuratore non apre i container né richiede password."

#: lib/main_configurator.py:338
msgid "LUKS persistence was requested at boot, but this initrd does not advertise crypto support. It cannot be activated until a crypto-capable initrd provides /run/initramfs/etc/minios-initramfs-crypt."
msgstr "La persistenza LUKS è stata richiesta all'avvio, ma questo initrd non indica il supporto alla crittografia. Non può essere attivata finché un initrd compatibile con la crittografia non fornisce /run/initramfs/etc/minios-initramfs-crypt."

#: lib/main_configurator.py:397
msgid "Detect current hostname, locale, timezone, and boot target."
msgstr "Rileva hostname, lingua, fuso orario e destinazione di avvio attuali."

#: lib/main_configurator.py:398
msgid "Detect current system settings"
msgstr "Rileva le impostazioni di sistema attuali"

#: lib/main_configurator.py:400
msgid "Detect the keyboard settings used by the current session."
msgstr "Rileva le impostazioni della tastiera utilizzate nella sessione corrente."

#: lib/main_configurator.py:401
msgid "Detect current keyboard"
msgstr "Rileva tastiera attuale"

#: lib/main_configurator.py:430
msgid "Preset only; individual settings are saved"
msgstr "Solo preimpostazione; vengono salvate le impostazioni individuali"

#: lib/main_configurator.py:433
msgid "Applies after reboot"
msgstr "Si applica dopo il riavvio"

#: lib/main_configurator.py:434
msgid "Only when creating a new session"
msgstr "Solo durante la creazione di una nuova sessione"

#: lib/main_configurator.py:487 lib/main_configurator.py:490
#: lib/main_configurator.py:491
msgid "Automatic"
msgstr "Automatico"

#: lib/main_configurator.py:488 lib/main_configurator.py:489
msgid "Use system default"
msgstr "Usa impostazioni di sistema"

#: lib/main_configurator.py:492 lib/main_configurator.py:493
#: lib/main_configurator.py:494 lib/main_configurator.py:495
#: lib/main_configurator.py:496
msgid "None"
msgstr "Nessuno"

#: lib/main_configurator.py:517
msgid "Enabled"
msgstr "Attivato"

#: lib/main_configurator.py:518
msgid "Disabled"
msgstr "Disattivato"

#: lib/main_configurator.py:557
msgid "Custom"
msgstr "Personalizzato"

#: lib/main_configurator.py:582
msgid "XRDP is not installed. This setting will be saved and used if XRDP is installed later."
msgstr "XRDP non è installato. Questa impostazione verrà salvata e applicata se XRDP verrà installato in seguito."

#: lib/main_configurator.py:607
msgid "Reset"
msgstr "Reimposta"

#: lib/main_configurator.py:610 lib/main_configurator.py:967
msgid "Review changes"
msgstr "Rivedi le modifiche"

#: lib/main_configurator.py:613
msgid "Save changes"
msgstr "Salva modifiche"

#: lib/main_configurator.py:715
msgid "This value is not valid."
msgstr "Questo valore non è valido."

#: lib/main_configurator.py:730
msgid "No unsaved changes"
msgstr "Nessuna modifica non salvata"

#: lib/main_configurator.py:732
msgid "1 unsaved change"
msgstr "1 modifica non salvata"

#: lib/main_configurator.py:734
#, python-brace-format
msgid "{count} unsaved changes"
msgstr "{count} modifiche non salvate"

#: lib/main_configurator.py:829
msgid "Detecting current system settings..."
msgstr "Rilevamento delle impostazioni di sistema in corso..."

#: lib/main_configurator.py:855
msgid "Automatic detection failed: {}"
msgstr "Rilevamento automatico non riuscito: {}"

#: lib/main_configurator.py:867
msgid "No system settings could be detected."
msgstr "Impossibile rilevare le impostazioni di sistema."

#: lib/main_configurator.py:871
msgid "1 setting updated. Changed fields are highlighted."
msgstr "1 impostazione aggiornata. I campi modificati sono evidenziati."

#: lib/main_configurator.py:873
#, python-brace-format
msgid "{count} settings updated. Changed fields are highlighted."
msgstr "{count} impostazioni aggiornate. I campi modificati sono evidenziati."

#: lib/main_configurator.py:877
msgid "Detected settings already match the values shown."
msgstr "Le impostazioni rilevate corrispondono già ai valori mostrati."

#: lib/main_configurator.py:891
msgid "Fix invalid fields before saving changes."
msgstr "Correggi i campi non validi prima di salvare le modifiche."

#: lib/main_configurator.py:922
msgid "Settings could not be saved: {}"
msgstr "Impossibile salvare le impostazioni: {}"

#: lib/main_configurator.py:926
msgid "Settings saved. They will be used on the next boot."
msgstr "Impostazioni salvate. Verranno applicate al prossimo avvio."

#: lib/main_configurator.py:968
msgid "Close"
msgstr "Chiudi"

#: lib/main_configurator.py:979
msgid "1 setting will change"
msgstr "1 impostazione verrà modificata"

#: lib/main_configurator.py:981
#, python-brace-format
msgid "{count} settings will change"
msgstr "{count} impostazioni verranno modificate"

#: lib/main_configurator.py:985
msgid "Review the current and new values before saving. Empty values use the MiniOS default."
msgstr "Controlla i valori attuali e quelli nuovi prima di salvare. I campi vuoti utilizzano il valore predefinito di MiniOS."

#: lib/main_configurator.py:1011 lib/main_configurator.py:1012
msgid "Not set (use default)"
msgstr "Non impostato (usa predefinito)"

#: lib/main_configurator.py:1057
msgid "A graphical tool for configuring MiniOS settings"
msgstr "Uno strumento grafico per configurare le impostazioni di MiniOS"

#: lib/main_configurator.py:1063
msgid "Path to config file (default: /etc/live/config.conf)"
msgstr "Percorso del file di configurazione (predefinito: /etc/live/config.conf)"

#: lib/main_configurator.py:1068
msgid "Inherit configuration parameters from kernel command line (/proc/cmdline)"
msgstr "Eredita i parametri di configurazione dalla riga di comando del kernel (/proc/cmdline)"

#: lib/validation_utils.py:65
msgid "A service cannot be both enabled and disabled: {}"
msgstr "Un servizio non può essere sia abilitato che disabilitato: {}"

#: lib/validation_utils.py:69
msgid "Choose either linked or bind-mounted user directories, not both."
msgstr "Scegli tra directory utente collegate o montate tramite bind, non entrambe."

#: lib/validation_utils.py:74
msgid "Enter a safe path inside the MiniOS drive, for example /minios/userdata."
msgstr "Inserisci un percorso sicuro all'interno dell'unità MiniOS, ad esempio /minios/userdata."

#: lib/validation_utils.py:76
msgid "SSH root login cannot be enabled while no-root mode is enabled."
msgstr "L'accesso root via SSH non può essere abilitato quando la modalità no-root è attiva."

#: share/applications/minios-configurator.desktop:4
