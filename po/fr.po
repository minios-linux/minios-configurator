#: lib/config_state.py:60 lib/config_state.py:61
msgid "Password unchanged"
msgstr "Mot de passe inchangé"

#: lib/config_state.py:61
msgid "Password will be changed"
msgstr "Le mot de passe sera modifié"

#: lib/config_utils.py:43 lib/config_utils.py:70
msgid "Config file must be a regular file."
msgstr "Le fichier de configuration doit être un fichier régulier."

#: lib/config_utils.py:57
msgid "Failed to load config: {}"
msgstr "Échec du chargement de la configuration : {}"

#: lib/config_utils.py:139
msgid "Failed to update config: {}"
msgstr "Échec de la mise à jour de la configuration : {}"

#: lib/main_configurator.py:71
msgid "User"
msgstr "Utilisateur"

#: lib/main_configurator.py:72
msgid "Username"
msgstr "Nom d'utilisateur"

#: lib/main_configurator.py:73
msgid ""
"Set the default username for the live session.\n"
"\n"
"• This user is created automatically at boot.\n"
"\n"
"See: man 7 live-config (search 'username')"
msgstr ""
"Définir le nom d'utilisateur par défaut pour la session live.\n"
"\n"
"• Cet utilisateur est créé automatiquement au démarrage.\n"
"\n"
"Voir : man 7 live-config (rechercher 'username')"

#: lib/main_configurator.py:76
msgid "Full name"
msgstr "Nom complet"

#: lib/main_configurator.py:77
msgid ""
"Enter the full name for the default user.\n"
"\n"
"• Used for display purposes (e.g., on login screens).\n"
"\n"
"See: man 7 live-config (search 'user-fullname')"
msgstr ""
"Entrez le nom complet de l'utilisateur par défaut.\n"
"\n"
"• Utilisé à des fins d'affichage (par exemple, sur les écrans de connexion).\n"
"\n"
"Voir : man 7 live-config (rechercher 'user-fullname')"

#: lib/main_configurator.py:80
msgid "User groups"
msgstr "Groupes d'utilisateurs"

#: lib/main_configurator.py:81
msgid ""
"Specify additional groups for the user, separated by commas or spaces.\n"
"\n"
"• Grants access to devices and features (e.g., 'audio, video, plugdev').\n"
"\n"
"See: man 7 live-config (search 'user-default-groups')"
msgstr ""
"Spécifiez des groupes supplémentaires pour l'utilisateur, séparés par des virgules ou des espaces.\n"
"\n"
"• Accorde l'accès aux périphériques et aux fonctionnalités (par exemple, 'audio, video, plugdev').\n"
"\n"
"Voir : man 7 live-config (rechercher 'user-default-groups')"

#: lib/main_configurator.py:84
msgid "User password"
msgstr "Mot de passe utilisateur"

#: lib/main_configurator.py:85
msgid ""
"Set the initial password for the default user.\n"
"\n"
"• Leave blank to keep the existing password.\n"
"• Spaces are not allowed.\n"
"\n"
"See: man 7 live-config (search 'user-password')"
msgstr ""
"Définir le mot de passe initial pour l'utilisateur par défaut.\n"
"\n"
"• Laisser vide pour conserver le mot de passe existant.\n"
"• Les espaces ne sont pas autorisés.\n"
"\n"
"Voir : man 7 live-config (rechercher 'user-password')"

#: lib/main_configurator.py:89
msgid "Root password"
msgstr "Mot de passe root"

#: lib/main_configurator.py:90
msgid ""
"Set the initial password for the root (administrator) account.\n"
"\n"
"• Leave blank to keep the existing password.\n"
"• Spaces are not allowed; ignored if 'No-root mode' is enabled.\n"
"\n"
"See: man 7 live-config (search 'root-password')"
msgstr ""
"Définir le mot de passe initial pour le compte root (administrateur).\n"
"\n"
"• Laisser vide pour conserver le mot de passe existant.\n"
"• Les espaces ne sont pas autorisés ; ignoré si le 'Mode sans root' est activé.\n"
"\n"
"Voir : man 7 live-config (rechercher 'root-password')"

#: lib/main_configurator.py:94
msgid "Link user directories to storage"
msgstr "Lier les dossiers utilisateur au stockage"

#: lib/main_configurator.py:95
msgid ""
"If enabled, user home directories will be symlinked to persistent storage.\n"
"\n"
"• Uses the FAT32, exFAT, or NTFS MiniOS drive.\n"
"• Unavailable with toram, toram=full, and toram=trim.\n"
"• Conflicting non-empty folders are never merged automatically.\n"
"\n"
"See: man 7 live-config (search 'link-user-dirs')"
msgstr ""
"Si activé, les répertoires personnels des utilisateurs seront liés par des liens symboliques vers le stockage persistant.\n"
"\n"
"• Utilise le disque MiniOS en FAT32, exFAT ou NTFS.\n"
"• Indisponible avec toram, toram=full et toram=trim.\n"
"• Les dossiers en conflit et non vides ne sont jamais fusionnés automatiquement.\n"
"\n"
"Voir : man 7 live-config (rechercher 'link-user-dirs')"

#: lib/main_configurator.py:100
msgid "Bind user directories to storage"
msgstr "Monter les dossiers utilisateur sur le stockage"

#: lib/main_configurator.py:101
msgid ""
"If enabled, user home directories will be bind-mounted to persistent storage.\n"
"\n"
"• Uses the FAT32, exFAT, or NTFS MiniOS drive.\n"
"• Unavailable with toram, toram=full, and toram=trim.\n"
"• Conflicting non-empty folders are never merged automatically.\n"
"\n"
"See: man 7 live-config (search 'bind-user-dirs')"
msgstr ""
"Si activé, les répertoires personnels des utilisateurs seront montés par liaison vers le stockage persistant.\n"
"\n"
"• Utilise le disque MiniOS en FAT32, exFAT ou NTFS.\n"
"• Indisponible avec toram, toram=full et toram=trim.\n"
"• Les dossiers en conflit et non vides ne sont jamais fusionnés automatiquement.\n"
"\n"
"Voir : man 7 live-config (rechercher 'bind-user-dirs')"

#: lib/main_configurator.py:106
msgid "User directories path on storage"
msgstr "Chemin des dossiers utilisateur sur le stockage"

#: lib/main_configurator.py:107
msgid ""
"Set the base path on persistent storage for user directories.\n"
"\n"
"• Example: '/minios/userdirs'.\n"
"\n"
"• The path must stay inside the MiniOS drive; '.', '..', and empty segments are not allowed.\n"
"\n"
"See: man 7 live-config (search 'user-dirs-path')"
msgstr ""
"Définit le chemin de base sur le stockage persistant pour les répertoires utilisateurs.\n"
"\n"
"• Exemple : '/minios/userdirs'.\n"
"\n"
"• Le chemin doit rester à l'intérieur du disque MiniOS ; '.', '..' et les segments vides ne sont pas autorisés.\n"
"\n"
"Voir : man 7 live-config (rechercher 'user-dirs-path')"

#: lib/main_configurator.py:112
msgid "System"
msgstr "Système"

#: lib/main_configurator.py:113
msgid "No-root mode"
msgstr "Mode sans root"

#: lib/main_configurator.py:114
msgid ""
"If enabled, disables the root account, enhancing security.\n"
"\n"
"• Prevents root login and administrator access.\n"
"• Ideal for live sessions.\n"
"\n"
"See: man 7 live-config (search 'noroot')"
msgstr ""
"Si activé, désactive le compte root, améliorant la sécurité.\n"
"\n"
"• Empêche la connexion root et l'accès administrateur.\n"
"• Idéal pour les sessions live.\n"
"\n"
"Voir : man 7 live-config (rechercher 'noroot')"

#: lib/main_configurator.py:118
msgid "Hostname"
msgstr "Nom d'hôte"

#: lib/main_configurator.py:119
msgid ""
"Set the computer's network name (hostname).\n"
"\n"
"• Allowed characters: letters, numbers, hyphens.\n"
"• Example: 'minios-pc'.\n"
"\n"
"See: man 7 live-config (search 'hostname')"
msgstr ""
"Définir le nom de réseau de l'ordinateur (nom d'hôte).\n"
"\n"
"• Caractères autorisés : lettres, chiffres, tirets.\n"
"• Exemple : 'minios-pc'.\n"
"\n"
"Voir : man 7 live-config (rechercher 'hostname')"

#: lib/main_configurator.py:123
msgid "Locales"
msgstr "Langues"

#: lib/main_configurator.py:124
msgid ""
"Set system language(s) and regional settings.\n"
"\n"
"• Enter locale codes separated by commas (e.g. 'de_DE.UTF-8, en_US.UTF-8').\n"
"• The first locale is treated as default.\n"
"\n"
"See: man 7 live-config (search 'locales')"
msgstr ""
"Définir la ou les langues du système et les paramètres régionaux.\n"
"\n"
"• Entrez les codes de paramètres régionaux séparés par des virgules (par exemple, 'de_DE.UTF-8, en_US.UTF-8').\n"
"• Le premier paramètre régional est considéré comme le paramètre par défaut.\n"
"\n"
"Voir : man 7 live-config (rechercher 'locales')"

#: lib/main_configurator.py:128
msgid "Timezone"
msgstr "Fuseau horaire"

#: lib/main_configurator.py:129
msgid ""
"Set the system timezone (e.g., 'Europe/Berlin', 'America/New_York').\n"
"\n"
"• Affects system clock and displayed times.\n"
"\n"
"See: man 7 live-config (search 'timezone')"
msgstr ""
"Définir le fuseau horaire du système (par exemple, 'Europe/Berlin', 'America/New_York').\n"
"\n"
"• Affecte l'horloge système et les heures affichées.\n"
"\n"
"Voir : man 7 live-config (rechercher 'timezone')"

#: lib/main_configurator.py:132
msgid "Default boot target"
msgstr "Cible de démarrage par défaut"

#: lib/main_configurator.py:133
msgid ""
"Set the default boot target:\n"
"• 'graphical.target' – start with a desktop.\n"
"• 'multi-user.target' – console mode.\n"
"• 'rescue.target' – minimal rescue mode.\n"
"\n"
"Short aliases like 'graphical' and 'multi-user' are accepted."
msgstr ""
"Définir la cible de démarrage par défaut :\n"
"• 'graphical.target' – démarrage avec un environnement graphique.\n"
"• 'multi-user.target' – mode console.\n"
"• 'rescue.target' – mode secours minimal.\n"
"\n"
"Les alias courts comme 'graphical' et 'multi-user' sont acceptés."

#: lib/main_configurator.py:138
msgid "Enable services"
msgstr "Activer les services"

#: lib/main_configurator.py:139
msgid ""
"List services to enable at boot, separated by commas.\n"
"\n"
"• Example: 'ssh, NetworkManager'.\n"
"• systemd units and sysvinit script names are supported."
msgstr ""
"Listez les services à activer au démarrage, séparés par des virgules.\n"
"\n"
"• Exemple : 'ssh, NetworkManager'.\n"
"• Les unités systemd et les noms de scripts sysvinit sont pris en charge."

#: lib/main_configurator.py:142
msgid "Disable services"
msgstr "Désactiver les services"

#: lib/main_configurator.py:143
msgid ""
"List services to disable at boot, separated by commas.\n"
"\n"
"• Example: 'bluetooth, ModemManager'.\n"
"• systemd units and sysvinit script names are supported."
msgstr ""
"Listez les services à désactiver au démarrage, séparés par des virgules.\n"
"\n"
"• Exemple : 'bluetooth, ModemManager'.\n"
"• Les unités systemd et les noms de scripts sysvinit sont pris en charge."

#: lib/main_configurator.py:147
msgid "Security"
msgstr "Sécurité"

#: lib/main_configurator.py:148
msgid "Security preset"
msgstr "Préréglage de sécurité"

#: lib/main_configurator.py:149
msgid "Choose a preset to fill the settings below. You can customize any setting afterward. Only the individual settings are saved."
msgstr "Choisissez un préréglage pour remplir les paramètres ci-dessous. Vous pouvez ensuite personnaliser chaque option. Seuls les paramètres individuels sont enregistrés."

#: lib/main_configurator.py:150
msgid "Sudo mode"
msgstr "Mode Sudo"

#: lib/main_configurator.py:151
msgid "passwordless keeps historical MiniOS behavior; password requires the user password; disabled removes the MiniOS sudo grant."
msgstr "‘passwordless’ conserve le comportement historique de MiniOS ; ‘password’ requiert le mot de passe utilisateur ; ‘disabled’ supprime l’autorisation sudo de MiniOS."

#: lib/main_configurator.py:152
msgid "PolicyKit mode"
msgstr "Mode PolicyKit"

#: lib/main_configurator.py:153
msgid "passwordless keeps historical MiniOS GUI admin convenience; password/disabled remove that rule and use normal PolicyKit authentication."
msgstr "‘passwordless’ conserve la commodité d’administration graphique historique de MiniOS ; ‘password’/‘disabled’ suppriment cette règle et utilisent l’authentification PolicyKit normale."

#: lib/main_configurator.py:154
msgid "SSH root login"
msgstr "Connexion root SSH"

#: lib/main_configurator.py:155
msgid "Allow or deny root login through OpenSSH."
msgstr "Autoriser ou interdire la connexion root via OpenSSH."

#: lib/main_configurator.py:156
msgid "SSH password authentication"
msgstr "Authentification par mot de passe SSH"

#: lib/main_configurator.py:157
msgid "Allow or deny password authentication through OpenSSH."
msgstr "Autoriser ou interdire l’authentification par mot de passe via OpenSSH."

#: lib/main_configurator.py:158
msgid "XRDP mode"
msgstr "Mode XRDP"

#: lib/main_configurator.py:159
msgid "relaxed keeps MiniOS defaults; hardened binds to localhost and disables root login; disabled disables common XRDP service links."
msgstr "‘relaxed’ conserve les paramètres par défaut de MiniOS ; ‘hardened’ lie à localhost et désactive la connexion root ; ‘disabled’ désactive les liens de service XRDP courants."

#: lib/main_configurator.py:160
msgid "X11 mode"
msgstr "Mode X11"

#: lib/main_configurator.py:161
msgid "relaxed keeps compatibility; hardened removes the permissive -ac launch option and tightens Xwrapper where present."
msgstr "‘relaxed’ conserve la compatibilité ; ‘hardened’ retire l’option de lancement permissive -ac et renforce Xwrapper si disponible."

#: lib/main_configurator.py:162
msgid "Show password hints"
msgstr "Afficher les indices de mot de passe"

#: lib/main_configurator.py:163
msgid "Show default root/live password hints in /etc/issue."
msgstr "Afficher les indices de mot de passe root/live par défaut dans /etc/issue."

#: lib/main_configurator.py:164
msgid "Lockscreen mode"
msgstr "Mode écran de verrouillage"

#: lib/main_configurator.py:165
msgid "relaxed keeps live-session convenience; hardened preserves/enables screen locking where supported."
msgstr "‘relaxed’ conserve la commodité de la session live ; ‘hardened’ active ou préserve le verrouillage d’écran lorsque c’est pris en charge."

#: lib/main_configurator.py:167
msgid "Keyboard"
msgstr "Clavier"

#: lib/main_configurator.py:168
msgid "Keyboard model"
msgstr "Modèle de clavier"

#: lib/main_configurator.py:169
msgid ""
"Specify the keyboard hardware model (e.g., 'pc105').\n"
"\n"
"• Leave blank for automatic detection.\n"
"\n"
"See: man 7 live-config (search 'keyboard-model')"
msgstr ""
"Spécifiez le modèle de matériel de clavier (par exemple, 'pc105').\n"
"\n"
"• Laisser vide pour une détection automatique.\n"
"\n"
"Voir : man 7 live-config (rechercher 'keyboard-model')"

#: lib/main_configurator.py:172
msgid "Keyboard layouts"
msgstr "Agencements de clavier"

#: lib/main_configurator.py:173
msgid ""
"List one or more keyboard layouts, separated by commas (e.g., 'us, ru').\n"
"\n"
"• Controls which layouts are available in the session.\n"
"\n"
"See: man 7 live-config (search 'keyboard-layouts')"
msgstr ""
"Répertorier un ou plusieurs agencements de clavier, séparés par des virgules (par exemple, 'us, ru').\n"
"\n"
"• Contrôle les agencements disponibles dans la session.\n"
"\n"
"Voir : man 7 live-config (rechercher 'keyboard-layouts')"

#: lib/main_configurator.py:176
msgid "Keyboard options"
msgstr "Options du clavier"

#: lib/main_configurator.py:177
msgid ""
"Set additional keyboard options (XKB).\n"
"\n"
"• Example: 'grp:alt_shift_toggle' to switch layouts with Alt+Shift.\n"
"\n"
"See: man 7 live-config (search 'keyboard-options')"
msgstr ""
"Définir des options de clavier supplémentaires (XKB).\n"
"\n"
"• Exemple : 'grp:alt_shift_toggle' pour basculer les agencements avec Alt+Shift.\n"
"\n"
"Voir : man 7 live-config (rechercher 'keyboard-options')"

#: lib/main_configurator.py:180
msgid "Keyboard variants"
msgstr "Variantes de clavier"

#: lib/main_configurator.py:181
msgid ""
"Specify keyboard variants for chosen layouts, separated by commas.\n"
"\n"
"• Customize layout (e.g., 'dvorak' for US).\n"
"• Leave blank if not needed.\n"
"\n"
"See: man 7 live-config (search 'keyboard-variants')"
msgstr ""
"Spécifiez les variantes de clavier pour les agencements choisis, séparées par des virgules.\n"
"\n"
"• Personnaliser l'agencement (par exemple, 'dvorak' pour US).\n"
"• Laisser vide si ce n'est pas nécessaire.\n"
"\n"
"Voir : man 7 live-config (rechercher 'keyboard-variants')"

#: lib/main_configurator.py:186
msgid "Advanced"
msgstr "Avancé"

#: lib/main_configurator.py:187
msgid "Module mode"
msgstr "Mode module"

#: lib/main_configurator.py:188
msgid ""
"Choose how system modules are loaded:\n"
"• 'simple' – load modules as-is.\n"
"• 'merged' – consolidates dpkg databases, passwd, shadow, and groups; updates caches.\n"
"\n"
"Usually not required unless modules are built independently.\n"
"See: man 7 live-config (search 'module-mode')"
msgstr ""
"Choisissez comment les modules système sont chargés :\n"
"• 'simple' – charger les modules tels quels.\n"
"• 'merged' – consolide les bases de données dpkg, passwd, shadow et groups ; met à jour les caches.\n"
"\n"
"Généralement pas nécessaire, sauf si les modules sont construits indépendamment.\n"
"Voir : man 7 live-config (rechercher 'module-mode')"

#: lib/main_configurator.py:193
msgid "live-config command line"
msgstr "Ligne de commande live-config"

#: lib/main_configurator.py:194
msgid ""
"Additional boot parameters for live-config (separated by spaces).\n"
"\n"
"• Passed at startup to control various session aspects.\n"
"• Example: 'boot=live live-config.debug'\n"
"\n"
"See: man 7 live-config (search 'cmdline')"
msgstr ""
"Paramètres de démarrage supplémentaires pour live-config (séparés par des espaces).\n"
"\n"
"• Transmis au démarrage pour contrôler divers aspects de la session.\n"
"• Exemple : 'boot=live live-config.debug'\n"
"\n"
"Voir : man 7 live-config (rechercher 'cmdline')"

#: lib/main_configurator.py:198
msgid "Debug mode"
msgstr "Mode débogage"

#: lib/main_configurator.py:199
msgid ""
"Activate to enable detailed debug output during boot.\n"
"\n"
"• Useful for troubleshooting configuration issues.\n"
"\n"
"See: man 7 live-config (search 'debug')"
msgstr ""
"Activer pour activer la sortie de débogage détaillée pendant le démarrage.\n"
"\n"
"• Utile pour résoudre les problèmes de configuration.\n"
"\n"
"Voir : man 7 live-config (rechercher 'debug')"

#: lib/main_configurator.py:202
msgid "Export logs to flash drive"
msgstr "Exporter les journaux sur une clé USB"

#: lib/main_configurator.py:203
msgid ""
"If enabled, MiniOS and live-config logs are copied to the writable MiniOS drive during every boot.\n"
"\n"
"• Each boot creates a timestamped directory under /minios/log.\n"
"• Useful for diagnostics and troubleshooting.\n"
"\n"
"See: https://github.com/minios-linux/minios-live/wiki"
msgstr ""
"Si cette option est activée, les journaux de MiniOS et live-config sont copiés sur le disque MiniOS en mode écriture à chaque démarrage.\n"
"\n"
"• À chaque démarrage, un dossier horodaté est créé sous /minios/log.\n"
"• Utile pour le diagnostic et le dépannage.\n"
"\n"
"Voir : https://github.com/minios-linux/minios-live/wiki"

#: lib/main_configurator.py:237 lib/main_configurator.py:296
#: share/applications/minios-configurator.desktop:4
msgid "MiniOS Configurator"
msgstr "Configurateur MiniOS"

#: lib/main_configurator.py:322
msgid "If you are unsure about a field, do not change it. Incorrect settings may prevent the system from booting."
msgstr "Si vous n'êtes pas sûr d'un champ, ne le modifiez pas. Des paramètres incorrects peuvent empêcher le démarrage du système."

#: lib/main_configurator.py:327
msgid "LUKS persistence encryption was requested at boot. Crypto support is provided by the initrd; this configurator does not open containers or request passwords."
msgstr "Le chiffrement persistant LUKS a été demandé au démarrage. La prise en charge du chiffrement est assurée par l’initrd ; ce configurateur n’ouvre pas les conteneurs et ne demande pas de mots de passe."

#: lib/main_configurator.py:332
msgid "LUKS persistence encryption was requested at boot, but this initrd does not advertise the layered crypto capability. It cannot be activated until a crypto-capable initrd provides /run/initramfs/etc/minios-initramfs-crypt."
msgstr "Le chiffrement persistant LUKS a été demandé au démarrage, mais cet initrd n’indique pas la prise en charge du chiffrement en couches. Il ne peut pas être activé tant qu’un initrd compatible chiffrement ne fournit pas /run/initramfs/etc/minios-initramfs-crypt."

#: lib/main_configurator.py:385
msgid "Detect current hostname, locale, timezone, and boot target."
msgstr "Détecter le nom d’hôte, la langue, le fuseau horaire et la cible de démarrage actuels."

#: lib/main_configurator.py:386
msgid "Detect current system settings"
msgstr "Détecter la configuration système actuelle"

#: lib/main_configurator.py:388
msgid "Detect the keyboard settings used by the current session."
msgstr "Détecter la configuration du clavier utilisée par la session en cours."

#: lib/main_configurator.py:389
msgid "Detect current keyboard"
msgstr "Détecter le clavier actuel"

#: lib/main_configurator.py:417
msgid "Preset only; individual settings are saved"
msgstr "Préréglage uniquement ; seuls les paramètres individuels sont enregistrés"

#: lib/main_configurator.py:420
msgid "Applies after reboot"
msgstr "S'applique après redémarrage"

#: lib/main_configurator.py:421
msgid "Only when creating a new session"
msgstr "Uniquement lors de la création d'une nouvelle session"

#: lib/main_configurator.py:457
msgid "Show password"
msgstr "Afficher le mot de passe"

#: lib/main_configurator.py:458
msgid "Hide password"
msgstr "Masquer le mot de passe"

#: lib/main_configurator.py:476 lib/main_configurator.py:479
#: lib/main_configurator.py:480
msgid "Automatic"
msgstr "Automatique"

#: lib/main_configurator.py:477 lib/main_configurator.py:478
msgid "Use system default"
msgstr "Utiliser la configuration système par défaut"

#: lib/main_configurator.py:481 lib/main_configurator.py:482
#: lib/main_configurator.py:483 lib/main_configurator.py:484
#: lib/main_configurator.py:485
msgid "None"
msgstr "Aucun"

#: lib/main_configurator.py:507
msgid "Enabled"
msgstr "Activé"

#: lib/main_configurator.py:508
msgid "Disabled"
msgstr "Désactivé"

#: lib/main_configurator.py:548
msgid "Custom"
msgstr "Personnalisé"

